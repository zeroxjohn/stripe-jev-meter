# Claim the sandbox or switch the Stripe CLI onto a full test account first.
# rkcs_ keys fall back to the in-process memory meter.
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_ID=

# Optional. Either key turns on live Jev. Without both, the recorded fake is used.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Filled by `stripe projects env` after Neon is attached.
# When set, the append-only ledger uses Postgres instead of .data/ledger.json.
DATABASE_URL=

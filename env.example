# Copy to .env.local. Never commit secrets.

# Optional. Either key turns on live Jev. Without both, the recorded fake is used.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Optional. In-memory meter receipts are used when this is empty.
# Claimable sandbox keys that start with rkcs_ also stay on the in-memory provider.
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_ID=
STRIPE_METER_FULL=support_resolution_full
STRIPE_METER_PARTIAL=support_resolution_partial
